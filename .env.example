# Single source of truth for all apps and packages.
# Copy to `.env` at the repo root: cp .env.example .env

# Database (shared by packages/database, apps/api, apps/worker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/pagepal"

# AWS S3 (apps/api + apps/worker via @pdf-chat-ai/nestjs-s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=

# Ports
API_PORT=3002
WORKER_PORT=3003
CORS_ORIGIN=http://localhost:3000

# LLM (Ollama) — qwen3 defaults to "thinking" mode which adds 10–40s before first token
LLM_CHAT_MODEL=qwen3:4b

# Frontend (apps/web) — also set in apps/web/.env.local for `next dev`
NEXT_PUBLIC_API_URL=http://localhost:3002
