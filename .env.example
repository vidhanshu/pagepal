# Single source of truth for all apps and packages.
# Copy to `.env` at the repo root: cp .env.example .env

# Database (shared by packages/database, apps/api, apps/worker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/pagepal"

# AWS S3 (apps/api + apps/worker via @pdf-chat-ai/nestjs-s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=

# Ports
API_PORT=3002
WORKER_PORT=3003
